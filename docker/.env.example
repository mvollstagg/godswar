# Copy to docker/.env (or .env in the repo root) and adjust.
# The root password is also written into the three server config.ini files.

DB_PASSWORD=godswar

# LoginServer version gate. This must equal the value the CLIENT sends as
# fVersion (build number, e.g. 1.0.267 -> 10267). If the client reports a
# version error, run docker/tools/login_probe.py --listen to read the exact
# number from the client and set it here.
CLIENT_VERSION=10267

# Name shown in the server list
SERVER_NAME=GodsWar
MAX_ONLINE=200

# 127.0.0.1 = play on this machine only.
# Set to the host's LAN IPv4 (ipconfig) to let other PCs on your network join.
ADVERTISE_IP=127.0.0.1

# Host ports that get published
LOGIN_PORT=5999
GAME_PORT=6001
